BOOKSTORE_DB_URI=mongodb://localhost:27017/rakc-platform

# Server Port
PORT=3001

# Existing Admin Console BetterAuth authority (origin only)
BOOKSTORE_AUTH_URL=http://localhost:3005
# Browser-visible bookstore origin; use HTTPS for both URLs in production
BOOKSTORE_PUBLIC_URL=http://localhost:5173
NODE_ENV=development

# RabbitMQ Connection (Optional - for email notifications)
# Leave empty to disable RabbitMQ integration
# Example: amqp://guest:guest@localhost:5672
RABBITMQ_URL=
