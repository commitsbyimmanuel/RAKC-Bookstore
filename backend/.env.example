# MongoDB Connection String
# Copy this file to .env.local and replace with your actual MongoDB URI
# For local MongoDB: mongodb://localhost:27017/Bookstore
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/Bookstore

MONGODB_URI=mongodb://localhost:27017/Bookstore

# Server Port
PORT=3001

# RabbitMQ Connection (Optional - for email notifications)
# Leave empty to disable RabbitMQ integration
# Example: amqp://guest:guest@localhost:5672
RABBITMQ_URL=
