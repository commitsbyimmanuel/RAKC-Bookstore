# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_QUEUE_EMAIL=email_notifications

# Email Service Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email Sender Details
EMAIL_FROM_NAME=RAKC Bookstore
EMAIL_FROM_ADDRESS=noreply@rakcbookstore.com

# MongoDB Configuration (for email logs/tracking)
MONGODB_URI=mongodb://mongodb:27017/Bookstore

# Scheduler Configuration
PAYMENT_REMINDER_CRON=0 9 * * MON
# Format: 0 9 * * MON (Every Monday at 9:00 AM)
# Adjust as needed for your weekly schedule

# Application Configuration
NODE_ENV=production
PORT=3002
